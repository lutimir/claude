# Skopíruj do .env v koreni repa: cp .env.example .env

# PostgreSQL (zhoduje sa s docker-compose.yml)
DATABASE_URL=postgres://app0:app0@localhost:5432/app0

# Prístup do /admin sekcie (HTTP Basic auth)
ADMIN_USER=admin
ADMIN_PASSWORD=zmen-ma

# Kontakt, ktorým sa identifikuje feed bot pri sťahovaní feedov (compliance)
FEED_FETCH_CONTACT=tvoj@email.sk

# Zobrazovaný názov appky
NEXT_PUBLIC_APP_NAME=App0
